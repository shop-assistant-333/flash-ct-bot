# Copy to .env.local and adjust. Only VITE_* vars reach the client bundle —
# never put secrets here, the bundle is public.

# Where the client sends API calls. A relative value goes through the Vite dev
# proxy in development and through the reverse proxy in production.
VITE_API_BASE_URL=/api

# Dev only: the Spring Boot instance the Vite proxy forwards /api to.
BACKEND_URL=http://localhost:8080
